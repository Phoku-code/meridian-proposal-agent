# Any OpenAI-compatible endpoint works. Defaults target Google's Gemini API
# (free key from https://aistudio.google.com -> Get API key).
LLM_API_KEY=paste-your-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash

# Where you unzipped the challenge pack (contains challenge-generator.html and sample-inputs/)
PACK_DIR=meridian-ai-challenge
